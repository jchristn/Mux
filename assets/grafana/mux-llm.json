          },
          "expr": "sum by (gen_ai_provider_name, gen_ai_operation_name) (rate(mux_llm_retries_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_provider_name}} {{gen_ai_operation_name}}",
