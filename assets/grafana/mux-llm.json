            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gen_ai_provider_name, gen_ai_operation_name, outcome) (increase(mux_llm_requests_total{job=~\"$job\", instance=~\"$instance\", outcome!=\"success\"}[$__range])) > 0",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
