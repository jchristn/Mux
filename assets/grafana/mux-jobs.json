        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(mux_job_stage_events_total{job=~\"$job\", instance=~\"$instance\", stage=\"run\", outcome!=\"success\"}[$__range]))",
