            "uid": "prometheus"
          },
          "expr": "sum(rate(mux_agent_runs_total{job=~\"$job\", instance=~\"$instance\", outcome!=\"completed\"}[$__rate_interval])) / clamp_min(sum(rate(mux_agent_runs_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])), 1e-9)",
