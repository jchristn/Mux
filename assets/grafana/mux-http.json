        "x": 12,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Latency (all routes)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
