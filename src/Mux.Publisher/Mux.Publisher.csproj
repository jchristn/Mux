<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Multi-targets net8.0;net10.0 (inherited from Directory.Build.props) so Test.Shared, which
         builds for both TFMs, can reference this project. In CI, invoke a single TFM by passing
         "-f net10.0" to dotnet run. -->
    <Version>0.12.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>Mux.Publisher</AssemblyName>
    <RootNamespace>Mux.Publisher</RootNamespace>
    <Description>mux release orchestrator: reads publisher.json and builds signed, self-contained installers and package-manager entries for Windows, macOS, and Linux.</Description>
  </PropertyGroup>

</Project>
