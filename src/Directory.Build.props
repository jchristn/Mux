<Project>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>jchristn</Authors>
    <Company>Joel Christner</Company>
    <Copyright>(c)2026 Joel Christner</Copyright>
    <!-- Shared package + repository metadata. These only take effect when a project is packed
         (dotnet pack); non-packable projects (exe/test) ignore them. Individual packable projects
         (Mux.Core, Mux.Search) add their own PackageId, Description, tags, README, and icon. -->
    <PackageProjectUrl>https://github.com/jchristn/Mux</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jchristn/Mux</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup>
    <!-- No blanket warning suppression. Nullable (CS86xx), obsolete-usage (CS0618), XML-documentation
         (CS1591/CS1572/CS1587), and other warnings must be fixed at the call site, not silenced here. -->
  </PropertyGroup>

</Project>
