{
  "name": "mux-ai",
  "displayName": "mux-ai",
  "description": "mux in your editor — chat, inline commands, native diffs, and shared sessions over the local mux agent.",
  "version": "1.0.0",
  "icon": "dashboard/media/icon.png",
  "publisher": "usemux",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jchristn/Mux.git",
    "directory": "src/Mux.VSCode"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "mux",
    "ai",
    "agent",
    "llm",
    "coding-agent"
  ],
  "main": "./out/src/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mux",
          "title": "mux",
          "icon": "dashboard/media/mux.svg"
        }
      ]
    },
    "views": {
      "mux": [
        {
          "id": "mux.chat",
          "name": "%view.chat.name%",
          "type": "webview"
        },
        {
          "id": "mux.sessions",
          "name": "%view.sessions.name%"
        },
        {
          "id": "mux.manage",
          "name": "%view.manage.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "mux.newConversation",
        "title": "%cmd.newConversation%",
        "category": "mux",
        "icon": "$(add)"
      },
      {
        "command": "mux.reconnect",
        "title": "%cmd.reconnect%",
        "category": "mux",
        "icon": "$(sync)"
      },
      {
        "command": "mux.cancelRun",
        "title": "%cmd.cancelRun%",
        "category": "mux",
        "icon": "$(stop-circle)"
      },
      {
        "command": "mux.mirrorSession",
        "title": "%cmd.mirrorSession%",
        "category": "mux",
        "icon": "$(broadcast)"
      },
      {
        "command": "mux.explainSelection",
        "title": "%cmd.explainSelection%",
        "category": "mux"
      },
      {
        "command": "mux.fixDiagnostic",
        "title": "%cmd.fixDiagnostic%",
        "category": "mux"
      },
      {
        "command": "mux.generateTests",
        "title": "%cmd.generateTests%",
        "category": "mux"
      },
      {
        "command": "mux.refactorSelection",
        "title": "%cmd.refactorSelection%",
        "category": "mux"
      },
      {
        "command": "mux.commitMessage",
        "title": "%cmd.commitMessage%",
        "category": "mux"
      },
      {
        "command": "mux.summarizeDiff",
        "title": "%cmd.summarizeDiff%",
        "category": "mux"
      },
      {
        "command": "mux.reviewFile",
        "title": "%cmd.reviewFile%",
        "category": "mux"
      },
      {
        "command": "mux.selectEndpoint",
        "title": "%cmd.selectEndpoint%",
        "category": "mux"
      },
      {
        "command": "mux.setWorkingDirectory",
        "title": "%cmd.setWorkingDirectory%",
        "category": "mux"
      },
      {
        "command": "mux.reviewChanges",
        "title": "%cmd.reviewChanges%",
        "category": "mux"
      },
      {
        "command": "mux.undo",
        "title": "%cmd.undo%",
        "category": "mux"
      },
      {
        "command": "mux.redo",
        "title": "%cmd.redo%",
        "category": "mux"
      },
      {
        "command": "mux.sessions.refresh",
        "title": "%cmd.sessions.refresh%",
        "category": "mux",
        "icon": "$(refresh)"
      },
      {
        "command": "mux.sessions.resume",
        "title": "%cmd.sessions.resume%",
        "category": "mux"
      },
      {
        "command": "mux.sessions.rename",
        "title": "%cmd.sessions.rename%",
        "category": "mux"
      },
      {
        "command": "mux.sessions.duplicate",
        "title": "%cmd.sessions.duplicate%",
        "category": "mux"
      },
      {
        "command": "mux.sessions.label",
        "title": "%cmd.sessions.label%",
        "category": "mux"
      },
      {
        "command": "mux.sessions.tag",
        "title": "%cmd.sessions.tag%",
        "category": "mux"
      },
      {
        "command": "mux.sessions.export",
        "title": "%cmd.sessions.export%",
        "category": "mux"
      },
      {
        "command": "mux.sessions.delete",
        "title": "%cmd.sessions.delete%",
        "category": "mux"
      },
      {
        "command": "mux.manage.refresh",
        "title": "%cmd.manage.refresh%",
        "category": "mux",
        "icon": "$(refresh)"
      },
      {
        "command": "mux.manage.addEndpoint",
        "title": "%cmd.manage.addEndpoint%",
        "category": "mux",
        "icon": "$(add)"
      },
      {
        "command": "mux.manage.editEndpoint",
        "title": "%cmd.manage.editEndpoint%",
        "category": "mux"
      },
      {
        "command": "mux.manage.deleteEndpoint",
        "title": "%cmd.manage.deleteEndpoint%",
        "category": "mux"
      },
      {
        "command": "mux.manage.setDefaultEndpoint",
        "title": "%cmd.manage.setDefaultEndpoint%",
        "category": "mux"
      },
      {
        "command": "mux.manage.addMcp",
        "title": "%cmd.manage.addMcp%",
        "category": "mux",
        "icon": "$(add)"
      },
      {
        "command": "mux.manage.editMcp",
        "title": "%cmd.manage.editMcp%",
        "category": "mux"
      },
      {
        "command": "mux.manage.deleteMcp",
        "title": "%cmd.manage.deleteMcp%",
        "category": "mux"
      },
      {
        "command": "mux.manage.activatePrompt",
        "title": "%cmd.manage.activatePrompt%",
        "category": "mux"
      },
      {
        "command": "mux.manage.addPrompt",
        "title": "%cmd.manage.addPrompt%",
        "category": "mux",
        "icon": "$(add)"
      },
      {
        "command": "mux.manage.editPrompt",
        "title": "%cmd.manage.editPrompt%",
        "category": "mux"
      },
      {
        "command": "mux.manage.deletePrompt",
        "title": "%cmd.manage.deletePrompt%",
        "category": "mux"
      },
      {
        "command": "mux.manage.editCatalog",
        "title": "%cmd.manage.editCatalog%",
        "category": "mux"
      },
      {
        "command": "mux.manage.resetCatalog",
        "title": "%cmd.manage.resetCatalog%",
        "category": "mux"
      },
      {
        "command": "mux.manage.addSubagent",
        "title": "%cmd.manage.addSubagent%",
        "category": "mux",
        "icon": "$(add)"
      },
      {
        "command": "mux.manage.editSubagent",
        "title": "%cmd.manage.editSubagent%",
        "category": "mux"
      },
      {
        "command": "mux.manage.deleteSubagent",
        "title": "%cmd.manage.deleteSubagent%",
        "category": "mux"
      },
      {
        "command": "mux.manage.toggleSkill",
        "title": "%cmd.manage.toggleSkill%",
        "category": "mux"
      },
      {
        "command": "mux.manage.addSkill",
        "title": "%cmd.manage.addSkill%",
        "category": "mux",
        "icon": "$(add)"
      },
      {
        "command": "mux.manage.editSkill",
        "title": "%cmd.manage.editSkill%",
        "category": "mux"
      },
      {
        "command": "mux.manage.deleteSkill",
        "title": "%cmd.manage.deleteSkill%",
        "category": "mux"
      },
      {
        "command": "mux.manage.editSettings",
        "title": "%cmd.manage.editSettings%",
        "category": "mux"
      },
      {
        "command": "mux.usage",
        "title": "%cmd.usage%",
        "category": "mux",
        "icon": "$(graph)"
      },
      {
        "command": "mux.setup",
        "title": "%cmd.runSetup%",
        "category": "mux",
        "icon": "$(rocket)"
      },
      {
        "command": "mux.showHelp",
        "title": "%cmd.showHelp%",
        "category": "mux"
      },
      {
        "command": "mux.about",
        "title": "%cmd.about%",
        "category": "mux",
        "icon": "$(info)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mux.explainSelection",
          "when": "editorHasSelection",
          "group": "mux@1"
        },
        {
          "command": "mux.refactorSelection",
          "when": "editorHasSelection",
          "group": "mux@2"
        },
        {
          "command": "mux.generateTests",
          "when": "editorHasSelection",
          "group": "mux@3"
        }
      ],
      "view/title": [
        {
          "command": "mux.newConversation",
          "when": "view == mux.chat",
          "group": "navigation"
        },
        {
          "command": "mux.sessions.refresh",
          "when": "view == mux.sessions",
          "group": "navigation"
        },
        {
          "command": "mux.manage.refresh",
          "when": "view == mux.manage",
          "group": "navigation"
        },
        {
          "command": "mux.about",
          "when": "view == mux.manage",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "mux.manage.addEndpoint",
          "when": "view == mux.manage && viewItem == section-endpoints",
          "group": "inline"
        },
        {
          "command": "mux.manage.addMcp",
          "when": "view == mux.manage && viewItem == section-mcp",
          "group": "inline"
        },
        {
          "command": "mux.manage.addPrompt",
          "when": "view == mux.manage && viewItem == section-prompts",
          "group": "inline"
        },
        {
          "command": "mux.manage.addSubagent",
          "when": "view == mux.manage && viewItem == section-subagents",
          "group": "inline"
        },
        {
          "command": "mux.manage.addSkill",
          "when": "view == mux.manage && viewItem == section-skills",
          "group": "inline"
        },
        {
          "command": "mux.usage",
          "when": "view == mux.manage && viewItem == section-usage",
          "group": "inline"
        },
        {
          "command": "mux.manage.editEndpoint",
          "when": "view == mux.manage && viewItem == endpoint",
          "group": "1@1"
        },
        {
          "command": "mux.manage.setDefaultEndpoint",
          "when": "view == mux.manage && viewItem == endpoint",
          "group": "1@2"
        },
        {
          "command": "mux.manage.deleteEndpoint",
          "when": "view == mux.manage && viewItem == endpoint",
          "group": "2@1"
        },
        {
          "command": "mux.manage.editMcp",
          "when": "view == mux.manage && viewItem == mcp",
          "group": "1@1"
        },
        {
          "command": "mux.manage.deleteMcp",
          "when": "view == mux.manage && viewItem == mcp",
          "group": "2@1"
        },
        {
          "command": "mux.manage.activatePrompt",
          "when": "view == mux.manage && viewItem == prompt",
          "group": "1@1"
        },
        {
          "command": "mux.manage.editPrompt",
          "when": "view == mux.manage && viewItem == prompt",
          "group": "1@2"
        },
        {
          "command": "mux.manage.deletePrompt",
          "when": "view == mux.manage && viewItem == prompt",
          "group": "2@1"
        },
        {
          "command": "mux.manage.editCatalog",
          "when": "view == mux.manage && viewItem == catalog-entry",
          "group": "1@1"
        },
        {
          "command": "mux.manage.resetCatalog",
          "when": "view == mux.manage && viewItem == catalog-entry",
          "group": "2@1"
        },
        {
          "command": "mux.manage.editSubagent",
          "when": "view == mux.manage && viewItem == subagent",
          "group": "1@1"
        },
        {
          "command": "mux.manage.deleteSubagent",
          "when": "view == mux.manage && viewItem == subagent",
          "group": "2@1"
        },
        {
          "command": "mux.manage.toggleSkill",
          "when": "view == mux.manage && viewItem == skill",
          "group": "1@1"
        },
        {
          "command": "mux.manage.editSkill",
          "when": "view == mux.manage && viewItem == skill",
          "group": "1@2"
        },
        {
          "command": "mux.manage.deleteSkill",
          "when": "view == mux.manage && viewItem == skill",
          "group": "2@1"
        },
        {
          "command": "mux.sessions.resume",
          "when": "view == mux.sessions",
          "group": "1@1"
        },
        {
          "command": "mux.sessions.rename",
          "when": "view == mux.sessions",
          "group": "1@2"
        },
        {
          "command": "mux.sessions.duplicate",
          "when": "view == mux.sessions",
          "group": "1@3"
        },
        {
          "command": "mux.sessions.label",
          "when": "view == mux.sessions",
          "group": "1@4"
        },
        {
          "command": "mux.sessions.tag",
          "when": "view == mux.sessions",
          "group": "1@5"
        },
        {
          "command": "mux.sessions.export",
          "when": "view == mux.sessions",
          "group": "2@1"
        },
        {
          "command": "mux.sessions.delete",
          "when": "view == mux.sessions",
          "group": "3@1"
        }
      ]
    },
    "configuration": {
      "title": "mux",
      "properties": {
        "mux.server.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "%config.server.autoStart%"
        },
        "mux.server.port": {
          "type": "number",
          "default": 0,
          "description": "%config.server.port%"
        },
        "mux.server.path": {
          "type": "string",
          "default": "mux",
          "description": "%config.server.path%"
        },
        "mux.defaultEndpoint": {
          "type": "string",
          "default": "",
          "description": "%config.defaultEndpoint%"
        },
        "mux.approvalPosture": {
          "type": "string",
          "enum": [
            "prompt",
            "auto-safe"
          ],
          "enumDescriptions": [
            "%config.approvalPosture.prompt%",
            "%config.approvalPosture.autoSafe%"
          ],
          "default": "prompt",
          "description": "%config.approvalPosture%"
        },
        "mux.context.sources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "activeFile",
              "selection",
              "diagnostics",
              "openTabs",
              "gitDiff",
              "symbols",
              "terminal"
            ]
          },
          "default": [
            "activeFile",
            "selection",
            "diagnostics"
          ],
          "description": "%config.context.sources%"
        },
        "mux.context.largeFileMode": {
          "type": "string",
          "enum": [
            "inherit",
            "map",
            "summarize",
            "truncate"
          ],
          "default": "inherit",
          "description": "%config.context.largeFileMode%"
        },
        "mux.locale": {
          "type": "string",
          "default": "",
          "description": "%config.locale%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit -p ./",
    "i18n": "node scripts/i18n-check.mjs",
    "i18n:gen": "node scripts/gen-locales.mjs",
    "test:unit": "npm run compile && node --test \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run compile && node ./out/test/integration/runTest.js",
    "test": "npm run test:unit",
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-electron": "^2.4.0",
    "glob": "^10.5.0",
    "mocha": "^10.4.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
