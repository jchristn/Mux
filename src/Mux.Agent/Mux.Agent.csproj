<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Version>1.3.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      No XAML is authored (the Avalonia app is entirely code), so disable the Avalonia XAML compilation
      task; it otherwise races on the intermediate assembly when net8.0 and net10.0 build in parallel. The
      tray icon is embedded as a plain resource and loaded from a manifest stream instead.
    -->
    <EnableAvaloniaXamlCompilation>false</EnableAvaloniaXamlCompilation>
    <Description>mux tray agent: cross-platform system-tray host for the optional local REST server.</Description>
    <ApplicationIcon>..\..\assets\icon-green.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Radiant" Version="0.1.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\icon-green.png" LogicalName="Mux.Agent.logo-green.png" />
    <EmbeddedResource Include="..\..\assets\icons\icon-macos.png" LogicalName="Mux.Agent.icon-macos.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mux.Core\Mux.Core.csproj" />
    <ProjectReference Include="..\Mux.Server\Mux.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Composition-root telemetry host (one Radiant host per process), shared by source link with the other
         mux executables. Libraries (Mux.Core, Mux.Server) emit through BCL Meter/ActivitySource only. -->
    <Compile Include="..\ObservabilityShared\*.cs" LinkBase="ObservabilityShared" />
  </ItemGroup>

</Project>
