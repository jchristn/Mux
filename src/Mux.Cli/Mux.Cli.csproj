<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>0.3.0</Version>
    <Description>CLI interface for mux AI agent</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mux</ToolCommandName>
    <PackageId>Mux.Cli</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.3.0: TUIKit front-end. The interactive UI is rebuilt on TUIKit (per-job transcripts, sidebar, slash/menu commands, tool-approval modal, resumable sessions, concurrent jobs with a single-writer lease). Test suite migrated to Touchstone. TUIKit is the rendering dependency (pinned to 0.2.0). The legacy Spectre.Console rendering and command-host dependencies have been removed.</PackageReleaseNotes>
    <NoWarn>$(NoWarn);NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- TUIKit (pinned, exact) drives the interactive UI. Source lives at C:\Code\TUIKit for reference
         only; always consume the published NuGet package, never a project reference. -->
    <PackageReference Include="TUIKit" Version="0.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mux.Core\Mux.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="App\Resources\thinking-messages.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

</Project>
