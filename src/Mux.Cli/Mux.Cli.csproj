<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>0.9.0</Version>
    <Description>CLI interface for mux AI agent</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mux</ToolCommandName>
    <PackageId>Mux.Cli</PackageId>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.5.0: Background tasks — the model decomposes a job into a tracked plan of tasks and advances them as it works, with a live in-place checklist in the interactive shell, a TASKS n/m sidebar row, a /tasks viewer for inspecting and hand-annotating the plan, per-job persistence across save/resume, and a task_plan_updated event in the jsonl automation contract. Gated by taskPlanningEnabled; an opt-in orchestration engine (taskParallelismEnabled) runs independent tasks as parallel jobs under the shared write lease. See CHANGELOG.md and BACKGROUND_TASKS.md.</PackageReleaseNotes>
    <NoWarn>$(NoWarn);NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- TUIKit (pinned, exact) drives the interactive UI. Source lives at C:\Code\TUIKit for reference
         only; always consume the published NuGet package, never a project reference. -->
    <PackageReference Include="TUIKit" Version="0.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mux.Core\Mux.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="App\Resources\thinking-messages.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

</Project>
