<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>0.3.0-alpha</Version>
    <Description>CLI interface for mux AI agent</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mux</ToolCommandName>
    <PackageId>Mux.Cli</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.3.0-alpha (alpha): begin the TUIKit front-end rewrite. Test suite migrated to Touchstone; TUIKit 0.2.0 added as the rendering dependency. The legacy Spectre.Console rendering and command-host dependencies have been removed.</PackageReleaseNotes>
    <NoWarn>$(NoWarn);NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- TUIKit (pinned, exact) will drive the rebuilt interactive UI. Source lives at C:\Code\TUIKit
         for reference only; always consume the published package, never a project reference. -->
    <PackageReference Include="TUIKit" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mux.Core\Mux.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

</Project>
