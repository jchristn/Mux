<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>1.6.0</Version>
    <Description>CLI interface for mux AI agent</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mux</ToolCommandName>
    <PackageId>Mux.Cli</PackageId>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>1.6.0: Opt-in Bash and PowerShell MCP execution with timeout and cancellation support; global and per-endpoint tool-approval countdowns; responsive idle MUX ASCII artwork. Includes provider, usage-chart, and test improvements. See CHANGELOG.md and docs/USAGE.md.</PackageReleaseNotes>
    <NoWarn>$(NoWarn);NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- TUIKit (pinned, exact) drives the interactive UI. Source lives at ~/Code/TUIKit for reference
         only; always consume the published NuGet package, never a project reference. -->
    <PackageReference Include="Radiant" Version="0.1.3" />
    <PackageReference Include="TUIKit" Version="1.11.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mux.Core\Mux.Core.csproj" />
    <ProjectReference Include="..\Mux.Server\Mux.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Composition-root telemetry host (one Radiant host per process), shared by source link with the other
         mux executables. Libraries (Mux.Core, Mux.Server) emit through BCL Meter/ActivitySource only. -->
    <Compile Include="..\ObservabilityShared\*.cs" LinkBase="ObservabilityShared" />
  </ItemGroup>

</Project>
