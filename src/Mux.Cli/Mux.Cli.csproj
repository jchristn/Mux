<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>0.3.0-alpha</Version>
    <Description>CLI interface for mux AI agent</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mux</ToolCommandName>
    <PackageId>Mux.Cli</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.3.0-alpha (alpha): begin the TUIKit front-end rewrite. Test suite migrated to Touchstone; TUIKit added as the rendering dependency. The interactive UI is being rebuilt on TUIKit; Spectre.Console is retained until the legacy renderer is replaced.</PackageReleaseNotes>
    <NoWarn>$(NoWarn);NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- TUIKit (pinned, exact) will drive the rebuilt interactive UI. Source lives at C:\Code\TUIKit
         for reference only; always consume the published package, never a project reference. -->
    <PackageReference Include="TUIKit" Version="0.1.0" />
    <!-- Spectre.Console (markup/live-display) is still directly used by the legacy interactive renderer
         (InteractiveCommand, EventRenderer, MarkdownRenderer, ToolCallRenderer, EndpointCommand). It is
         retained until those are rebuilt on TUIKit, then removed. Spectre.Console.Cli (arg parsing) is
         kept regardless and also supplies Spectre.Console transitively. -->
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.53.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mux.Core\Mux.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

</Project>
