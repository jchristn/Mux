<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>0.3.0</Version>
    <Description>CLI interface for mux AI agent</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mux</ToolCommandName>
    <PackageId>Mux.Cli</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.3.0: TUIKit front-end. The interactive UI is rebuilt on TUIKit (per-job transcripts, sidebar, command palette/slash/menu, tool-approval modal, resumable sessions, concurrent jobs with a single-writer lease). Test suite migrated to Touchstone. TUIKit is the rendering dependency (pinned to 0.2.0). The legacy Spectre.Console rendering and command-host dependencies have been removed.</PackageReleaseNotes>
    <NoWarn>$(NoWarn);NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- TUIKit (pinned, exact) will drive the rebuilt interactive UI. TARGET: 0.3.1 (validated on
         Windows, Linux, and macOS) — bump this pin the moment 0.3.1 is published to NuGet; it is not
         on the feed yet (latest is 0.2.0), and pinning a missing package breaks restore. Source lives
         at C:\Code\TUIKit for reference only; always consume the published package, never a project
         reference. -->
    <PackageReference Include="TUIKit" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mux.Core\Mux.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

</Project>
