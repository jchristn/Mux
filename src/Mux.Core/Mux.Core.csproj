<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.2.0</Version>
    <Title>Mux.Core</Title>
    <PackageId>Mux.Core</PackageId>
    <Description>The mux engine: agent loop with streaming events, built-in tools, MCP client, skills, subagents, session persistence, checkpoints, approval/sandbox governance, and usage telemetry — backend-agnostic across Ollama, OpenAI, Azure, Anthropic, Gemini, Vertex, Bedrock, and any OpenAI-compatible API. Build your own experiences on top of mux.</Description>
    <PackageTags>mux;ai;agent;llm;openai;ollama;anthropic;gemini;mcp;coding-agent;tools</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packaged into the NuGet package root (README rendered on nuget.org, icon as the package icon). -->
    <None Include="PACKAGE.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\assets\icon-black.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cosmetic "thinking…" phrase pool, shared by the TUI and desktop via ThinkingPhrases. -->
    <EmbeddedResource Include="Conversation\Resources\thinking-messages.txt" />
    <EmbeddedResource Include="Skills\Resources\mux-skill.ps1" LogicalName="Mux.Core.Skills.mux-skill.ps1" />
    <EmbeddedResource Include="Skills\Evaluation\skill-eval.json" LogicalName="Mux.Core.Skills.Evaluation.skill-eval.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Folder-based default skills and opt-in skill packs. Every file is embedded under a logical name that keeps
         its path relative to the folder (RecursiveDir separators are normalized in code), and nothing under these
         folders is compiled or copied to the output, so skill scripts and assets are data, never project code. -->
    <Compile Remove="Skills\Bundled\**;Skills\Packs\**" />
    <None Remove="Skills\Bundled\**;Skills\Packs\**" />
    <Content Remove="Skills\Bundled\**;Skills\Packs\**" />
    <EmbeddedResource Include="Skills\Bundled\**\*" LogicalName="Mux.Core.Skills.Bundled/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Skills\Packs\**\*" LogicalName="Mux.Core.Skills.Packs/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Files merged into existing default skills from imported sources (SKILLS_TO_CONSIDER.md "Adapt" items),
         seeded under each skill's resources/ folder by AdaptedSkillResources. -->
    <None Remove="Skills\Resources\Adapted\**" />
    <EmbeddedResource Include="Skills\Resources\Adapted\**\*" LogicalName="Mux.Core.Skills.Adapted/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Pin the native SQLite bundle to a patched build; the version Microsoft.Data.Sqlite pulls
         transitively (2.1.10) carries advisory GHSA-2m69-gcr7-jv3q. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageReference Include="PolyPrompt" Version="3.1.0" />
    <PackageReference Include="Voltaic" Version="2.2.1" />
    <!-- SourceLink is bundled in the .NET 8+ SDK; PublishRepositoryUrl/EmbedUntrackedSources
         (in Directory.Build.props) drive the source-linked .snupkg with no extra package. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mux.Search\Mux.Search.csproj" />
  </ItemGroup>

</Project>
