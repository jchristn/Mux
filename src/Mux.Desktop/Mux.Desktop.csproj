<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Version>0.10.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <ApplicationIcon>..\..\assets\icon-black.ico</ApplicationIcon>
    <Description>mux Desktop: cross-platform Avalonia desktop client for the mux agent.</Description>
    <!--
      The Phase 0 foundation is authored in code (no XAML), matching the proven Mux.Agent pattern.
      Disabling the Avalonia XAML compilation task avoids a parallel-build race on the shared
      intermediate assembly when net8.0 and net10.0 build together. XAML views are introduced in
      later phases; see DESKTOP_APP.md.
    -->
    <EnableAvaloniaXamlCompilation>false</EnableAvaloniaXamlCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\icon-black.png" LogicalName="Mux.Desktop.logo-black.png" />
    <EmbeddedResource Include="..\..\assets\icon-white.png" LogicalName="Mux.Desktop.logo-white.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mux.Core\Mux.Core.csproj" />
    <ProjectReference Include="..\Mux.Desktop.Core\Mux.Desktop.Core.csproj" />
  </ItemGroup>

</Project>
