<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Local co-development feed for PolyPrompt. PolyPrompt 2.5.0 (native Anthropic, Gemini,
      Azure OpenAI, Vertex AI, and Bedrock clients) is built locally and not yet published to
      nuget.org, so restore it from the sibling repo's Release output. Remove this source once
      PolyPrompt 2.5.0 is published to nuget.org.
    -->
    <add key="polyprompt-local" value="..\PolyPrompt\src\PolyPrompt\bin\Release" />
  </packageSources>
</configuration>
