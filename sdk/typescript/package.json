{
  "name": "@mux/sdk",
  "version": "0.7.0",
  "description": "Thin TypeScript driver for the mux CLI: spawns `mux print --output-format jsonl` and yields typed events.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/mux.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mux",
    "ai",
    "agent",
    "cli",
    "llm"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.7.0"
  }
}
