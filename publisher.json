{
  "schemaVersion": 1,
  "project": {
    "name": "mux",
    "displayName": "mux",
    "identifier": "ai.latticetech.mux",
    "tagline": "Your AI agent. Your models. Your infra. Anywhere.",
    "publisher": "Lattice AI, LLC",
    "publisherUrl": "https://latticetech.ai",
    "maintainer": "Lattice AI, LLC <hello@latticetech.ai>",
    "repo": "jchristn/mux",
    "homepage": "https://github.com/jchristn/mux",
    "description": "An open-source AI coding agent for the terminal, desktop, web dashboard, and VS Code, with the models you choose, local or remote, and Mux Cloud for reaching your machines from anywhere.",
    "license": "MIT"
  },
  "build": {
    "artifacts": [
      { "id": "cli", "csproj": "src/Mux.Cli/Mux.Cli.csproj", "kind": "DotnetTool" },
      { "id": "desktop", "csproj": "src/Mux.Desktop/Mux.Desktop.csproj", "kind": "Gui", "bundle": [
        { "csproj": "src/Mux.Agent/Mux.Agent.csproj", "role": "agent" },
        { "csproj": "src/Mux.Cli/Mux.Cli.csproj", "role": "cli" }
      ] }
    ],
    "frameworks": [ "net10.0", "net8.0" ],
    "runtimes": [ "win-x64", "win-arm64", "osx-x64", "osx-arm64", "linux-x64", "linux-arm64" ]
  },
  "channels": {
    "nuget":         { "enabled": true, "artifact": "cli", "os": "linux", "options": { "vaultRef": "NUGET_API_KEY" } },
    "cli-archive":   { "enabled": true, "driver": "archive", "artifact": "cli", "os": "linux", "runtimes": [ "linux-x64", "linux-arm64" ] },
    "cli-archive-windows": { "enabled": true, "driver": "archive", "artifact": "cli", "os": "windows", "runtimes": [ "win-arm64" ] },
    "scoop":         { "enabled": true, "artifact": "cli", "os": "windows", "runtimes": [ "win-x64" ], "options": { "bucket": "jchristn/scoop-bucket" } },
    "homebrew":      { "enabled": true, "artifact": "cli", "os": "macos", "runtimes": [ "osx-x64", "osx-arm64" ], "options": { "tap": "jchristn/homebrew-tap" } },
    "homebrew-cask": { "enabled": true, "driver": "homebrew", "artifact": "desktop", "os": "macos", "runtimes": [ "osx-x64", "osx-arm64" ], "options": { "tap": "jchristn/homebrew-tap" } },

    "inno":          { "enabled": true, "artifact": "desktop", "runtimes": [ "win-x64", "win-arm64" ] },
    "wix":           { "enabled": false, "artifact": "desktop", "runtimes": [ "win-x64" ] },
    "winget":        { "enabled": true, "artifact": "desktop", "runtimes": [ "win-x64" ], "options": { "packageId": "jchristn.mux", "vaultRef": "WINGET_TOKEN" } },
    "chocolatey":    { "enabled": true, "artifact": "desktop", "runtimes": [ "win-x64" ], "options": { "vaultRef": "CHOCO_API_KEY" } },

    "pkg":           { "enabled": true, "artifact": "desktop", "runtimes": [ "osx-x64", "osx-arm64" ] },
    "dmg":           { "enabled": true, "artifact": "desktop", "runtimes": [ "osx-x64", "osx-arm64" ] },

    "debrpm":        { "enabled": true, "artifact": "desktop", "runtimes": [ "linux-x64", "linux-arm64" ] },
    "appimage":      { "enabled": true, "artifact": "desktop", "runtimes": [ "linux-x64", "linux-arm64" ] },
    "apt":           { "enabled": true, "artifact": "desktop", "runtimes": [ "linux-x64" ], "options": { "suite": "stable", "component": "main" } },
    "yum":           { "enabled": true, "artifact": "desktop", "runtimes": [ "linux-x64" ] },
    "snap":          { "enabled": false, "artifact": "desktop", "runtimes": [ "linux-x64" ], "options": { "confinement": "classic" } },
    "flatpak":       { "enabled": false, "artifact": "desktop", "runtimes": [ "linux-x64" ], "options": { "appId": "ai.latticetech.mux" } }
  },
  "signing": {
    "//": "No paid code-signing certificates, by policy (see ~/Code/Agents/requirements/INSTALLERS.md). Windows installers ship unsigned (SmartScreen: More info, Run anyway). macOS apps are ad-hoc signed (codesign --sign -), which Apple silicon requires, and are not notarized (Privacy & Security, Open Anyway). Linux repo metadata is signed with a free, self-generated GPG key. To enable paid signing later, add 'windows'/'macOs' entries here and the matching secrets.",
    "linux":   { "vaultRef": "GPG_SIGNING", "notarize": false }
  },
  "releaseNotes": { "source": "CHANGELOG.md", "section": "## {version}" }
}
